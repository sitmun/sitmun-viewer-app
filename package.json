{
  "name": "sitmun-viewer-app",
  "version": "1.2.9",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:e2e": "node scripts/start-e2e.mjs",
    "build": "export NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=8192}\" && ng build",
    "build:e2e": "export NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=8192}\" && ng build --configuration=e2e",
    "build:win": "set NODE_OPTIONS=--max-old-space-size=8192 && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --watchAll=false",
    "lint": "ng lint",
    "format": "npx prettier --write src",
    "clean": "bash scripts/clean.sh",
    "clean:force": "bash scripts/clean.sh --force",
    "clean:build": "bash scripts/clean.sh --build-only",
    "postinstall": "node scripts/patch-printmap-logo.js && node scripts/patch-wfs-110-parser.js && node scripts/patch-api-sitna-empty-dts.js"
  },
  "private": true,
  "engines": {
    "node": "^24.22.0 || ^26.0.0"
  },
  "overrides": {
    "pdfmake": "0.1.70",
    "@typescript-eslint/utils": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/types": "^8.54.0"
  },
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "api-sitna": "^4.8.0",
    "dompurify": "^3.4.2",
    "jwt-decode": "^3.1.2",
    "meld": "^1.3.2",
    "ngx-pagination": "^6.0.3",
    "pako": "^2.1.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.0",
    "url-template": "^3.1.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^22.0.1",
    "@angular-builders/jest": "^22.0.1",
    "@angular-devkit/build-angular": "^22.2.3",
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@eslint/js": "^9.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@typescript-eslint/types": "^8.54.0",
    "angular-eslint": "^22.6.0",
    "babel-jest": "^29.5.0",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^9.28.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^16.2.0",
    "prettier": "^3.0.0",
    "process": "^0.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.54.0",
    "util": "^0.12.5",
    "webpack": "5.98.0",
    "webpack-cli": "^6.0.1"
  }
}
